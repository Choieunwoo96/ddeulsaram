# 이 파일을 복사해서 .env.local 로 이름을 바꾸고 실제 값을 채워 넣으세요.
# .env.local 은 .gitignore에 포함되어 있어 GitHub에는 올라가지 않습니다.
#
# 값은 Supabase 프로젝트 > Project Settings > API 에서 확인할 수 있습니다.
#   - SUPABASE_URL              -> "Project URL"
#   - SUPABASE_SERVICE_ROLE_KEY -> "service_role" 시크릿 키 (절대 외부에 공개 금지)
#   - SUPABASE_ANON_KEY         -> "anon" / "public" 키 (회원가입·로그인 기능에 사용)

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 회원가입/로그인(Supabase Auth) 기능에 필요합니다. service_role 키와 달리
# 외부에 노출돼도 되는 값이지만, 그래도 이 파일을 그대로 GitHub에 올리진 마세요.
# 이 값이 없으면 로그인/회원가입 버튼은 "아직 설정 안 됨" 안내만 뜨고, 나머지
# 사이트 기능은 평소처럼 정상 작동합니다.
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 실시간 채팅 기능에 필요합니다. 위 SUPABASE_URL / SUPABASE_ANON_KEY와 똑같은 값을
# 그대로 복사해서 넣으면 됩니다 (NEXT_PUBLIC_ 접두사만 다름). anon key라 브라우저에
# 노출돼도 되는 값입니다. 이 값이 없으면 채팅 위젯이 화면에 아예 나타나지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# /admin 페이지 로그인 비밀번호. 직접 정하는 값이며(아무 문자열이나 가능),
# 이 비밀번호를 아는 사람은 모든 방/매칭 대기열을 삭제할 수 있으니
# 아무에게나 알려주면 안 됩니다.
ADMIN_PASSWORD=원하는-비밀번호로-바꾸세요

# 사이트맵(sitemap.xml)·robots.txt·SEO 메타데이터에 쓰이는 실제 배포 주소.
# 지금 쓰고 계신 주소를 그대로 넣으면 됩니다 (끝에 슬래시 없이).
# 나중에 커스텀 도메인을 연결하면 이 값도 그 도메인으로 바꿔주세요.
NEXT_PUBLIC_SITE_URL=https://ddeulsaram96.vercel.app

# (선택) Google Search Console에서 소유권 확인 시 발급되는 값.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=여기에-발급된-값
